# Local development defaults
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///tandingin.db
# Optional direct PostgreSQL connection for Alembic/data migrations only.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
STORAGE_BACKEND=local
AUTO_INIT_DB=0
FLASK_DEBUG=1

# First-run local admin. Change these values before running init-db.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Production on Vercel: set these in Vercel Environment Variables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require  (pooled runtime URL)
# STORAGE_BACKEND=vercel_blob
# Preferred on Vercel after connecting a Private Blob store: BLOB_STORE_ID + Vercel OIDC are injected automatically.
# BLOB_READ_WRITE_TOKEN=replace-with-private-blob-token  # optional manual token alternative
# The Vercel Blob store itself must be created with access mode Private.
